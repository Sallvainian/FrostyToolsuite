<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FrostyModManager.ViewModels"
        xmlns:models="using:FrostyModManager.Models"
        x:Class="FrostyModManager.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Frosty Mod Manager"
        Width="1100" Height="760" MinWidth="760" MinHeight="520"
        DragDrop.AllowDrop="True">

  <Grid RowDefinitions="Auto,*,Auto,Auto,200" Margin="12">

    <!-- game picker -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
      <TextBlock Grid.Column="0" Text="Game" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
      <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}"
                IsEnabled="{Binding !IsBusy}"/>
      <Button Grid.Column="2" Content="Browse…" Margin="8,0,0,0" Click="OnBrowseGame" IsEnabled="{Binding !IsBusy}"/>
    </Grid>

    <!-- mod list + details -->
    <Grid Grid.Row="1" ColumnDefinitions="3*,Auto,2*">
      <DockPanel Grid.Column="0">
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" Opacity="0.7"
                   Text="Mods higher in the list win when two mods change the same asset. Drop .fbmod / .fbcollection / .zip files here."
                   TextWrapping="Wrap"/>
        <Border BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="4">
          <Panel>
            <ListBox x:Name="ModList" ItemsSource="{Binding Mods}" SelectedItem="{Binding SelectedMod}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:ModItem">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Margin="4,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Byline}" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Category}" FontSize="12" Opacity="0.5"
                               VerticalAlignment="Center" Margin="8,0,4,0"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="No mods yet. Click “Add mods…” or drop files onto the window."
                       HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5"
                       IsVisible="{Binding !Mods.Count}"/>
          </Panel>
        </Border>
      </DockPanel>

      <StackPanel Grid.Column="1" Margin="8,22,8,0" Spacing="6" Width="110">
        <Button HorizontalAlignment="Stretch" Content="Add mods…" Click="OnAddMods" IsEnabled="{Binding IsReady}"/>
        <Button HorizontalAlignment="Stretch" Content="Remove" Command="{Binding RemoveModCommand}"/>
        <Separator Margin="0,4"/>
        <Button HorizontalAlignment="Stretch" Content="Move up" Command="{Binding MoveUpCommand}"/>
        <Button HorizontalAlignment="Stretch" Content="Move down" Command="{Binding MoveDownCommand}"/>
      </StackPanel>

      <Border Grid.Column="2" Margin="0,22,0,0" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="4" Padding="12">
        <Panel>
          <ScrollViewer IsVisible="{Binding SelectedMod, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel Spacing="6">
              <TextBlock Text="{Binding SelectedMod.Title, FallbackValue=''}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding SelectedMod.Byline, FallbackValue=''}" Opacity="0.7"/>
              <TextBlock Text="{Binding SelectedMod.FileName, FallbackValue=''}" Opacity="0.5" FontSize="12" TextWrapping="Wrap"/>
              <SelectableTextBlock Text="{Binding SelectedMod.ModPageLink, FallbackValue=''}" Opacity="0.7" FontSize="12" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding SelectedMod.Description, FallbackValue=''}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
          </ScrollViewer>
          <TextBlock Text="Select a mod to see its details." Opacity="0.5"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     IsVisible="{Binding SelectedMod, Converter={x:Static ObjectConverters.IsNull}}"/>
        </Panel>
      </Border>
    </Grid>

    <!-- actions -->
    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,12,0,8">
      <Button Grid.Column="0" Content="Set up from running game" Command="{Binding SetupCommand}"
              IsVisible="{Binding NeedsSetup}" Classes="accent"/>
      <TextBlock Grid.Column="1" Text="{Binding Status}" VerticalAlignment="Center" Margin="12,0" TextWrapping="Wrap"/>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
        <Button Content="Apply" Command="{Binding ApplyCommand}"/>
        <Button Content="Launch vanilla" Command="{Binding LaunchVanillaCommand}"/>
        <Button Content="Launch modded" Command="{Binding LaunchModdedCommand}" Classes="accent"/>
      </StackPanel>
    </Grid>

    <ProgressBar Grid.Row="3" IsIndeterminate="{Binding IsBusy}" Height="4" MinHeight="4" Margin="0,0,0,6"/>

    <!-- log -->
    <Border Grid.Row="4" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="4" Background="#18000000">
      <Grid RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="*,Auto" Margin="8,4,4,0">
          <TextBlock Text="Log" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <Button Grid.Column="1" Content="Clear" Command="{Binding ClearLogCommand}" Padding="8,2" FontSize="12"/>
        </Grid>
        <ListBox x:Name="LogList" Grid.Row="1" ItemsSource="{Binding Log}" Background="Transparent">
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="8,1"/>
              <Setter Property="MinHeight" Value="0"/>
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="models:LogLine">
              <SelectableTextBlock Text="{Binding Text}" Foreground="{Binding Brush}" FontFamily="monospace" FontSize="12" TextWrapping="Wrap"/>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>
  </Grid>
</Window>
